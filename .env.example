# ──────────────────────────────────────────────────────
# Supabase — https://supabase.com/dashboard/project/_/settings/api
# ──────────────────────────────────────────────────────
# Project URL (예: https://xxxx.supabase.co)
SUPABASE_URL=
# service_role 키 (서버 전용, 공개 금지) — anon 키는 아래
SUPABASE_SERVICE_ROLE_KEY=
# anon/public 키 (클라이언트 노출 가능, service_role 없을 때 fallback)
SUPABASE_ANON_KEY=
# 파일 저장 버킷 이름 (Storage > New bucket 에서 생성, 기본값: keg-outputs)
SUPABASE_STORAGE_BUCKET=keg-outputs

# ──────────────────────────────────────────────────────
# Google OAuth (Blogger API) — Google Cloud Console에서 발급
# ──────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js v5 — https://authjs.dev/getting-started/deployment
# 로컬 개발: npm run dev → http://127.0.0.1:3000 (또는 localhost:3000)
AUTH_URL=http://127.0.0.1:3000
# 비우면: 개발용 기본 시크릿으로 대체(500 방지). 공개 서비스 전에는 반드시 설정
AUTH_SECRET=
# (호환) 기존 이름 — Auth.js가 읽지 않을 수 있으면 AUTH_* 사용
NEXTAUTH_URL=http://127.0.0.1:3000
NEXTAUTH_SECRET=

# OAuth 리다이렉트 (예: Next.js + Auth.js 기본 경로)
# 로컬: http://127.0.0.1:3000/api/auth/callback/google (localhost 병행 시 Google Console에 둘 다 등록)
OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback/google

# 세션·JWT 서명 (AUTH_SECRET 권장)
# openssl rand -base64 32

# Buffer GraphQL API (인스타·Threads 큐잉) — 발급: Buffer Publish 설정의 API
# https://developers.buffer.com/
BUFFER_API_ACCESS_TOKEN=

# 뉴스레터 — 메일리 (https://maily.so/) — Buffer는 이메일 뉴스레터 발송용이 아님
# 개발자 API: https://maily.so/app/guides/dev/dev-api  (Base: https://api.maily.so , Bearer 토큰)
# MAILY_API_KEY=
# MAILY_API_BASE=https://api.maily.so
# 구독자 목록 경로가 계정과 다르면(개발자 메뉴 기준) 예: /v1/subscribers
# MAILY_SUBSCRIBERS_PATH=/subscribers

# Google Gemini API — 카드뉴스 슬라이드 이미지 생성 (서버에서만 호출)
# https://ai.google.dev/gemini-api/docs
# /card-news — 키 없으면 프롬프트만 _output/card-news/*.txt 저장
# GEMINI_API_KEY=

# ──────────────────────────────────────────────────────
# 발행 큐 워커 cron 트리거 — /api/cron/publish 호출 시 필요
# Authorization: Bearer <CRON_SECRET> 헤더로 인증. Vercel Cron 등록 시 동일 값 사용.
# 미설정 시 503 응답 (안전 차단). 권장: openssl rand -hex 32
# ──────────────────────────────────────────────────────
CRON_SECRET=

# ──────────────────────────────────────────────────────
# 운영자 화이트리스트 — /admin/db-health 진단 페이지 접근 제한
# 콤마/세미콜론/공백 구분 가능. 비우면 모든 로그인 사용자 접근 가능(개발 편의).
# ──────────────────────────────────────────────────────
# ADMIN_EMAILS=you@example.com,teammate@example.com
