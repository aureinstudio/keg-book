{
  "name": "keg-book",
  "version": "1.0.0",
  "private": true,
  "description": "KEG 출판 교재 바이럴·콘텐츠 마케팅 웹앱",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run typecheck",
    "build": "next build",
    "preview": "npm run build && next start --hostname 127.0.0.1 --port 3000",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/genai": "^2.0.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^25.6.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "next": "^15.5.18",
    "next-auth": "^5.0.0-beta.25",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.14",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.18",
    "vitest": "^2.1.9"
  }
}
